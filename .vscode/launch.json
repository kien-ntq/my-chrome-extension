{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Run webpack",
            "runtimeExecutable": "webpack",
            "cwd": "${workspaceFolder}",
            "args": []
        },
        {
            "type": "node-terminal",
            "name": "Run Script: test (current file)",
            "request": "launch",
            "command": "npm run test ${file}",
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "node-terminal",
            "name": "Run Script: unit test",
            "request": "launch",
            "command": "npm run unit",
            "cwd": "${workspaceFolder}"
        }
    ]
}